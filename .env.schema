# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# 
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# @plugin(@varlock/aws-secrets-plugin)
# @initAws(region=eu-central-1, namePrefix="/mv/")
# @currentEnv=$VARLOCK_ENV
# ----------

# -- Branch configuration (raw branch name, sanitized in plugin for resource names) --
# @public
BRANCH_NAME=$VARLOCK_BRANCH
# @public
VITE_BRANCH_NAME=$VARLOCK_BRANCH

# -- AWS CDK configuration --
# @public @type=enum(dev,prod)
CDK_ENVIRONMENT=dev
# @type=email(normalize=true) @optional
CDK_BUDGET_ALERT_EMAIL=if(forEnv(test), "test@example.com", awsParam("cdk-reporting-email"))
# @type=email(normalize=true) @optional
CDK_MONITORING_ALERT_EMAIL=if(forEnv(test), "test@example.com", awsParam("cdk-reporting-email"))
# Maintainer-only: include MailInfraStack in CDK synthesis (never set during routine branch deploys)
# @optional @type=boolean
CDK_DEPLOY_MAIL_INFRA=false

# -- Better Auth configuration --
# @sensitive @type=string @required
BETTER_AUTH_SECRET=if(forEnv(test), "test-secret-for-better-auth", awsParam("better-auth-secret"))

# -- Behold Instagram feed --
# @sensitive @type=string @required
BEHOLD_FEED_URL=if(forEnv(test), "https://feeds.behold.so/zFgp2Jbbk23Ovf1ZUOhq", awsParam("behold-feed-url"))

# --- Sentry configuration ---
# @sensitive @type=string @required
SENTRY_AUTH_TOKEN=if(forEnv(test), "test-sentry-auth-token", awsParam("sentry-auth-token"))
# @type=enum(dev,prod)
SENTRY_ENVIRONMENT=dev

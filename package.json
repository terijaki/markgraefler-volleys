{
  "name": "markgraefler-volleys.de",
  "version": "2.0.0",
  "private": true,
  "homepage": "https://markgraefler-volleys.de",
  "bugs": {
    "url": "https://github.com/terijaki/markgraefler-volleys/issues"
  },
  "author": {
    "name": "Björn Kohnen",
    "email": "bjoern@markgraefler-volleys.de"
  },
  "type": "module",
  "scripts": {
    "start": "node app/.output/server/index.mjs",
    "test": "vp test",
    "test:e2e": "playwright test",
    "lint": "vp lint",
    "check": "vp check --fix",
    "verify": "vp check --fix && vp test --reporter=minimal",
    "db:seed": "bun ./scripts/db-seed.ts",
    "db:seed:user": "varlock run -- sh -c 'bun ./scripts/db-seed.ts --user \"$CDK_BUDGET_ALERT_EMAIL\"'",
    "db:seed:sams": "bun ./scripts/data-trigger-syncs.ts",
    "cdk:deploy": "cdk deploy --require-approval=never",
    "cdk:deploy:all": "cdk deploy --all --require-approval=never",
    "cdk:deploy:prod": "CDK_ENVIRONMENT=prod cdk deploy --all",
    "cdk:deploy:mail-infra": "CDK_DEPLOY_MAIL_INFRA=true cdk deploy MailInfraStack-Dev --require-approval=never",
    "cdk:deploy:mail-infra:prod": "CDK_ENVIRONMENT=prod CDK_DEPLOY_MAIL_INFRA=true cdk deploy MailInfraStack-Prod --require-approval=never",
    "cdk:deploy:buntime": "CDK_DEPLOY_BUNTIME=true cdk deploy BunTimeStack-Dev --require-approval=never",
    "cdk:deploy:buntime:prod": "CDK_ENVIRONMENT=prod CDK_DEPLOY_BUNTIME=true cdk deploy BunTimeStack-Prod --require-approval=never",
    "cdk:synth:mail-infra": "CDK_DEPLOY_MAIL_INFRA=true cdk synth MailInfraStack-Dev",
    "cdk:synth:mail-infra:prod": "CDK_ENVIRONMENT=prod CDK_DEPLOY_MAIL_INFRA=true cdk synth MailInfraStack-Prod",
    "cdk:diff:mail-infra": "CDK_DEPLOY_MAIL_INFRA=true cdk diff MailInfraStack-Dev",
    "cdk:diff:mail-infra:prod": "CDK_ENVIRONMENT=prod CDK_DEPLOY_MAIL_INFRA=true cdk diff MailInfraStack-Prod",
    "cdk:synth:buntime": "CDK_DEPLOY_BUNTIME=true cdk synth BunTimeStack-Dev",
    "cdk:synth:buntime:prod": "CDK_ENVIRONMENT=prod CDK_DEPLOY_BUNTIME=true cdk synth BunTimeStack-Prod",
    "cdk:diff:buntime": "CDK_DEPLOY_BUNTIME=true cdk diff BunTimeStack-Dev",
    "cdk:diff:buntime:prod": "CDK_ENVIRONMENT=prod CDK_DEPLOY_BUNTIME=true cdk diff BunTimeStack-Prod",
    "cdk:synth:all": "cdk synth --all",
    "cdk:synth:prod": "CDK_ENVIRONMENT=prod cdk synth --all",
    "cdk:diff": "cdk diff",
    "cdk:diff:all": "cdk diff --all",
    "cdk:diff:prod": "CDK_ENVIRONMENT=prod cdk diff --all",
    "cdk:destroy": "CDK_DESTROY=true cdk destroy --require-approval=never",
    "cdk:destroy:all": "CDK_DESTROY=true cdk destroy --all --require-approval=never",
    "cdk:bootstrap": "cdk bootstrap"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.34.0",
    "@aws-lambda-powertools/tracer": "^2.34.0",
    "@aws-sdk/client-dynamodb": "3.1085.0",
    "@aws-sdk/client-s3": "3.1085.0",
    "@aws-sdk/client-sesv2": "3.1085.0",
    "@aws-sdk/lib-dynamodb": "3.1085.0",
    "@aws-sdk/s3-request-presigner": "3.1085.0",
    "@aws-sdk/util-dynamodb": "3.996.6",
    "@mantine/core": "^9.4.1",
    "@mantine/dates": "^9.4.1",
    "@mantine/dropzone": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@mantine/notifications": "^9.4.1",
    "@mantine/tiptap": "^9.4.1",
    "@middy/core": "^7.7.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@sentry/aws-serverless": "^10.65.0",
    "@sentry/react": "^10.65.0",
    "@sentry/tanstackstart-react": "^10.65.0",
    "@tanstack/react-form-start": "^1.33.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.28",
    "@tiptap/extension-image": "^3.27.4",
    "@tiptap/extension-link": "^3.27.4",
    "@tiptap/react": "^3.27.4",
    "@tiptap/starter-kit": "^3.27.4",
    "@varlock/aws-secrets-plugin": "^1.2.2",
    "@voidzero-dev/vite-plus-core": "0.2.1",
    "aws-xray-sdk-core": "^3.12.0",
    "better-auth": "1.6.23",
    "dayjs": "^1.11.21",
    "dynamodb-toolbox": "^2.10.0",
    "lucide-react": "^1.24.0",
    "nitro": "^3.0.260610-beta",
    "num-words-de": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-world-flags": "^1.6.0",
    "sams-rest-v2": "^0.1.9",
    "superjson": "^2.2.6",
    "ts-ics": "^2.4.6",
    "varlock": "^1.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-lambda": "3.1085.0",
    "@behold/types": "^0.3.4",
    "@playwright/test": "^1.61.1",
    "@sentry/vite-plugin": "^5.3.0",
    "@tanstack/router-plugin": "^1.168.20",
    "@types/aws-lambda": "^8.10.162",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@varlock/vite-integration": "^1.1.3",
    "@vitejs/plugin-react": "^6.0.3",
    "aws-cdk": "^2.1130.0",
    "aws-cdk-lib": "^2.261.0",
    "aws-sdk-client-mock": "^4.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "bun-types": "1.4.0",
    "constructs": "^10.6.0",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.19",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.1",
    "vite-plus": "0.2.1"
  },
  "engines": {
    "node": ">=25"
  },
  "packageManager": "bun@1.4.0"
}
